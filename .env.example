# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Virou
NODE_ENV=development
ENABLE_LOCAL_DEV_AUTH=false
NEXT_PUBLIC_ENABLE_LOCAL_DEV_STORE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REQUIRE_EMAIL_CONFIRMATION=true

# IA
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=final-beta-v1

# Rate limit distribuído (obrigatório em produção com IA e escritas públicas)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-mail e notificações
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Mapas e geocodificação
MAPS_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
DEFAULT_COUNTRY=BR
DEFAULT_TIMEZONE=America/Sao_Paulo

# Segurança
RATE_LIMIT_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Observabilidade opcional
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Features
NEXT_PUBLIC_FEATURE_AI=true
NEXT_PUBLIC_FEATURE_AI_BUSINESS_ANALYSIS=true
NEXT_PUBLIC_FEATURE_AI_JOURNEY_COMPOSITION=true
NEXT_PUBLIC_FEATURE_AI_SOURCE_IMPORT=true
NEXT_PUBLIC_FEATURE_AI_BRAND_ANALYSIS=true

NEXT_PUBLIC_FEATURE_QUALIFICATION=true
NEXT_PUBLIC_FEATURE_QUOTES=true
NEXT_PUBLIC_FEATURE_SCHEDULING=true
NEXT_PUBLIC_FEATURE_ROUTING=true
NEXT_PUBLIC_FEATURE_GEO_ROUTING=true
NEXT_PUBLIC_FEATURE_CATALOG_ORDERS=true
NEXT_PUBLIC_FEATURE_RESERVATIONS=true
NEXT_PUBLIC_FEATURE_EXTERNAL_PAYMENTS=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true

NEXT_PUBLIC_FEATURE_CALENDAR_SYNC=false
NEXT_PUBLIC_FEATURE_CHAT=false
NEXT_PUBLIC_FEATURE_BILLING=false
NEXT_PUBLIC_FEATURE_CUSTOM_DOMAINS=false
NEXT_PUBLIC_FEATURE_MULTI_UNIT=true
NEXT_PUBLIC_FEATURE_CONVERSION_GOALS=true
NEXT_PUBLIC_FEATURE_ENTRY_POINTS=true
NEXT_PUBLIC_FEATURE_OPPORTUNITIES=true
NEXT_PUBLIC_FEATURE_CONVERSION_ANALYTICS=true
NEXT_PUBLIC_FEATURE_AI_OPTIMIZATION=false
NEXT_PUBLIC_FEATURE_PRESENCE=true
NEXT_PUBLIC_FEATURE_PRESENCE_AI=true
NEXT_PUBLIC_FEATURE_PRESENCE_MULTI_PAGE=true
# Activation, benefits and identity
NEXT_PUBLIC_FEATURE_ACTIVATIONS=true
NEXT_PUBLIC_FEATURE_BENEFIT_CLAIMS=true
NEXT_PUBLIC_FEATURE_HUMAN_REDEMPTION=true
NEXT_PUBLIC_FEATURE_CUSTOMER_HISTORY_IMPORT=true
CUSTOMER_IDENTITY_HASH_SECRET=
