{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e-3016/types/**/*.ts",
    ".next-e2e-3016/dev/types/**/*.ts",
    ".next-e2e-mode-toggle/types/**/*.ts",
    ".next-e2e-mode-toggle/dev/types/**/*.ts",
    ".next-e2e-publish/types/**/*.ts",
    ".next-e2e-publish/dev/types/**/*.ts",
    ".next-e2e-publication/types/**/*.ts",
    ".next-e2e-publication/dev/types/**/*.ts",
    ".next-e2e-publication-2/types/**/*.ts",
    ".next-e2e-publication-2/dev/types/**/*.ts",
    ".next-e2e-publication-3/types/**/*.ts",
    ".next-e2e-publication-3/dev/types/**/*.ts",
    ".next-e2e-publication-4/types/**/*.ts",
    ".next-e2e-publication-4/dev/types/**/*.ts",
    ".next-e2e-publication-5/types/**/*.ts",
    ".next-e2e-publication-5/dev/types/**/*.ts",
    ".next-e2e-publication-6/types/**/*.ts",
    ".next-e2e-publication-6/dev/types/**/*.ts",
    ".next-e2e-publication-7/types/**/*.ts",
    ".next-e2e-publication-7/dev/types/**/*.ts",
    ".next-e2e-publication-step/types/**/*.ts",
    ".next-e2e-publication-step/dev/types/**/*.ts",
    ".next-e2e-publication-step-confirm/types/**/*.ts",
    ".next-e2e-publication-step-confirm/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
